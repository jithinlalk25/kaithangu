# Server-only. Never prefix this with NEXT_PUBLIC_ — the browser must never see it.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: pin a specific Gemini model.
# Defaults to gemini-3.5-flash-lite locally and gemini-3.6-flash in production.
# GEMINI_MODEL=gemini-3.6-flash
